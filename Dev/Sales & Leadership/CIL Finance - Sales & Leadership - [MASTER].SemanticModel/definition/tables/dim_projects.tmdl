	column previous_week = ```
			
			IF(
			    dim_projects[live_date] >= TODAY() - WEEKDAY(TODAY(), 2) - 6 &&
			    dim_projects[live_date] <= TODAY() - WEEKDAY(TODAY(), 2),
			    TRUE(),
			    FALSE()
			)
			
