table _invoicing_collections
	lineageTag: 046ac436-0bcc-406b-833a-d2eb3cbd0e0f

	measure 'Incl. sales tax' =
			SWITCH(SELECTEDVALUE('_invoicing_collections'[Label]),
			                "Cash collected", [Cash collected (incl. tax)],
			                "Invoiced", [Invoiced (incl. tax)],
			                BLANK())
		formatString: "£"#,0;-"£"#,0;"£"#,0
		lineageTag: 93d376ca-65e0-4430-89ec-a7b4cfe4036a

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Excl. sales tax' =
