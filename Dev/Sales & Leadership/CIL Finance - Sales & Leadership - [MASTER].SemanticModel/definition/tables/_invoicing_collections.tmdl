			                "Cash collected", [Cash collected (Excl. tax)],
			                "Invoiced", [Invoiced (Excl. tax)],
			                BLANK())
		formatString: "£"#,0;-"£"#,0;"£"#,0
		lineageTag: 13d0e3ae-b4fa-47d5-858b-986dd11ab02a

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

