	/// Helper column for checking whether any of the delivery roles have a non-0 contribution % for a given project-contributor combination
	measure 'Delivery Role Check' =
			
			IF(
			    (COALESCE ( [Lead advisor %], 0 ) > 0)
			    || (COALESCE ( [Delivery owner %], 0 ) > 0)
			    || (COALESCE ( [Expert (delivery) %], 0 ) > 0),
			    1,
			    0
			)
		formatString: 0
		displayFolder: Contributions
		lineageTag: e7631bf8-381c-4d0b-a17e-933eb1ac5d64

	/// Helper column for checking whether any of the sales roles have a non-0 contribution % for a given project-contributor combination
	measure 'Sales Role Check' =
			
			IF(
			    (COALESCE ( [Origination %], 0 ) > 0)
			    || (COALESCE ( [Leadership %], 0 ) > 0)
			    || (COALESCE ( [Expert (sales) %], 0 ) > 0),
			    1,
			    0
			)
		formatString: 0
		displayFolder: Contributions
		lineageTag: e19bcc08-da71-491b-bef2-61a8d07e9931

	/// Returns the names of other people who also contributed as an originator to a given project. 
	measure 'Other Originators' =
			
			VAR ThisContributor = SELECTEDVALUE ( 'fact_contributions'[contributor_name] )
			VAR ThisProject     = SELECTEDVALUE ( 'dim_projects'[project_id] )
			RETURN
			CONCATENATEX (
			    FILTER (
			        ALL ( 'fact_contributions' ),
			        'fact_contributions'[project_id] = ThisProject
			            && 'fact_contributions'[contribution_allocated] = "origination"
			            && 'fact_contributions'[contributor_name] <> ThisContributor
			    ),
			    'fact_contributions'[contributor_name],
			    ", "
			)
		displayFolder: Contributions
		lineageTag: 142a7bce-4ba4-41a5-8abd-a871e42981df

