	/// Calculates the share of project revenue attributable to each contributor based on their recorded contribution allocation, filtered by the selected roles, people, and dates. Uses the raw stored percentages without re-normalizing across roles.
	measure 'Revenue (Contribution)' =
			
			SUMX (
			    fact_contributions,
			    VAR Proj  = fact_contributions[project_id]
			    VAR Share = fact_contributions[contribution_allocation]
			    VAR ProjRevenue =
			        CALCULATE ( [Revenue], TREATAS ( { Proj }, 'fact_revenue'[project_id] ) )
			    RETURN Share * ProjRevenue
			)
		formatString: "£"#,0;-"£"#,0;"£"#,0
		displayFolder: Revenue
		lineageTag: 85755483-ecf3-4bf1-98d9-a51353cfc81c

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	/// Origination % returns the percentage share of project contribution allocated to a contributor in the origination role. It filters the contribution data for that role and averages the allocation value at the Project-Contributor level.
	measure 'Origination %' =
			
			VAR HasRow =
			    HASONEVALUE('dim_projects'[project_id]) &&
			    HASONEVALUE('fact_contributions'[contributor_name])
			RETURN
			IF(
			    HasRow,
			    CALCULATE(
			        AVERAGE('fact_contributions'[contribution_allocation]),
			        KEEPFILTERS('dim_contributions_lookup'[contribution_allocated] = "origination"),
			        KEEPFILTERS('dim_contributions_lookup'[contribution_allocated] <> "Not allocated")
			    )
			)
		formatString: 0%;-0%;0%
		displayFolder: Contributions
		lineageTag: 824e530c-5a56-4949-8785-772bf2dc635e

	/// Leadership % returns the percentage share of project contribution allocated to a contributor in the leadership role. It filters the contribution data for that role and averages the allocation value at the Project-Contributor level.
	measure 'Leadership %' =
			
			VAR HasRow =
			    HASONEVALUE('dim_projects'[project_id]) &&
			    HASONEVALUE('fact_contributions'[contributor_name])
			RETURN
			IF(
			    HasRow,
			    CALCULATE(
			        AVERAGE('fact_contributions'[contribution_allocation]),
			        KEEPFILTERS('dim_contributions_lookup'[contribution_allocated] = "leadership"),
			        KEEPFILTERS('dim_contributions_lookup'[contribution_allocated] <> "Not allocated")
			    )
			)
		formatString: 0%;-0%;0%
		displayFolder: Contributions
		lineageTag: 6c2125ed-58f2-4b4c-b054-fd7c76f016eb

	/// Expert (Sales) % returns the percentage share of project contribution allocated to a contributor in the expert (sales) role. It filters the contribution data for that role and averages the allocation value at the Project-Contributor level.
	measure 'Expert (Sales) %' =
			
			VAR HasRow =
			    HASONEVALUE('dim_projects'[project_id]) &&
			    HASONEVALUE('fact_contributions'[contributor_name])
