	/// Delivery Owner % returns the percentage share of project contribution allocated to a contributor in the delivery owner role. It filters the contribution data for that role and averages the allocation value at the Project-Contributor level.
	measure 'Delivery Owner %' =
			
			VAR HasRow =
			    HASONEVALUE('dim_projects'[project_id]) &&
