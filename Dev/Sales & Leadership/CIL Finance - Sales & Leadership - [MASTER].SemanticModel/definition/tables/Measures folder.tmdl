	measure 'Revenue %' = DIVIDE([Revenue], CALCULATE([Revenue], REMOVEFILTERS('fact_revenue'[region], 'fact_revenue'[setting_allocated], 'fact_revenue'[geography_allocated]), REMOVEFILTERS(dim_projects[client_target_size_category])), 0)
		formatString: 0%;-0%;0%
		displayFolder: Revenue
		lineageTag: 5be7faf2-d685-4033-b233-5683413d7873

	measure 'Combined revenue %' = DIVIDE([Combined revenue], CALCULATE([Combined revenue], REMOVEFILTERS('fact_revenue'[geography_allocated])), 0)
		formatString: 0%;-0%;0%
		displayFolder: Revenue
		lineageTag: 33047140-1dad-45bd-aca7-e9eae2f837e5

	measure 'Left to Budget' = MAX([Budget] - [Revenue], 0)
		formatString: "£"#,0;-"£"#,0;"£"#,0
