	measure 'Revenue Up to Current Month' = ```
			
			CALCULATE(
			    [Revenue],
			    FILTER(
			        ALL('dim_date'),
			        'dim_date'[Date] <= EOMONTH(TODAY(), 0)
			    )
			)
			
			```
		formatString: "£"#,0.0;-"£"#,0.0;"£"#,0.0
		displayFolder: KPIs
