	measure '% Min Fee' = ```
			DIVIDE([Min fee], CALCULATE([Min fee], REMOVEFILTERS(dim_projects[region], dim_projects[setting], dim_projects[client_target_size_category]))) 
			```
		formatString: 0.0%;-0.0%;0.0%
