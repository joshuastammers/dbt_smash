		displayFolder: Fees
		lineageTag: c279d16b-f163-4d2e-8db9-bfcac4104b2d

	measure 'Allocation %' = AVERAGEX('fact_revenue', AVERAGE('fact_revenue'[allocation_pct]))
		formatString: 0%;-0%;0%
		displayFolder: Revenue
		lineageTag: d9c1a289-e173-4ead-b07d-ee399288d6ec

	measure Allocation = ```
			[Final fee] * [Allocation %]
			
			```
		formatString: "£"#,0;-"£"#,0;"£"#,0
		displayFolder: Revenue
		lineageTag: 4af78656-2c97-469d-8c88-48f6d85ed8c9

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Final fee - live date' = CALCULATE([Final fee], USERELATIONSHIP(dim_date[Date], dim_projects[live_date]))
