	measure WIP = [Revenue Up to Current Month] - [Invoiced]
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		displayFolder: WIP
		lineageTag: 17906e9e-e008-49e1-916e-2ffb4cec61c2

