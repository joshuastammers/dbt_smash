	/// Expert (Delivery) % returns the percentage share of project contribution allocated to a contributor in the expert (delivery) role. It filters the contribution data for that role and averages the allocation value at the Project-Contributor level.
	measure 'Expert (Delivery) %' =
			
			VAR HasRow =
			    HASONEVALUE('dim_projects'[project_id]) &&
			    HASONEVALUE('fact_contributions'[contributor_name])
			RETURN
			IF(
			    HasRow,
			    CALCULATE(
			        AVERAGE('fact_contributions'[contribution_allocation]),
			        KEEPFILTERS('dim_contributions_lookup'[contribution_allocated] = "expert_project")
