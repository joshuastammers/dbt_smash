		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Min Fee - Moving Average (Weekly)' = ```
			
			VAR SelectedWeeks = SELECTEDVALUE('param_moving_average_n'[param_moving_averages_series], 4)
			VAR DaysBack = SelectedWeeks * 7
			VAR CurrentWeek = MAX('dim_date'[Week])
			VAR DateWindow = 
			    DATESINPERIOD(
			        'dim_date'[Week],
			        CurrentWeek,
			        -DaysBack,
			        DAY
			    )
			RETURN
			    AVERAGEX(
			        DateWindow,
			        CALCULATE([Min fee])
			    )
			```
		formatString: "£"#,0;-"£"#,0;"£"#,0
		displayFolder: Fees
		lineageTag: 1c27149f-fdaf-461b-96ac-5ec6eddd9794

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	/// Calculates moving average minimum fee, according to the number of months (N) entered in the slicer on the 'Orders (Monthly)' tab
	measure 'Min Fee - Moving Average (Monthly)' = ```
			
			VAR PERIOD = 
			DATESINPERIOD(
			    'dim_date'[Date],
			    MAX('dim_date'[Date]),
			    -[Selected Moving Average N (Monthly)],
			    MONTH
			)
			VAR TotalSales =  
			    CALCULATE(
			        [Min fee],
			        PERIOD
			    )
			VAR Mon = 
			    CALCULATE(
			        DISTINCTCOUNT('dim_date'[Month]),
			        PERIOD
			    )
			RETURN
			    DIVIDE(TotalSales, Mon)
			```
		formatString: "£"#,0;-"£"#,0;"£"#,0
		displayFolder: Fees
		lineageTag: 268263f3-2d78-4dcc-8be8-c1599b0fcce5

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	/// Gives sum of total billable hours as a % of total hours logged in timesheets
	measure 'Available Hours %' = ```
			
			DIVIDE(
			    SUM('fact_timesheets'[hours_billable]),
			    SUM('fact_timesheets'[total_hours]),
			    0
			) 
			```
		formatString: 0%;-0%;0%
		displayFolder: Timesheet
		lineageTag: abb0f715-ba07-4be8-a11e-848c0b3c8e12

