table _measure
	lineageTag: 0476adec-7bee-4b78-924f-1efac213b752

	measure 'People with TOIL requirements' =
			CALCULATE(
			    COUNT('openair_toil'[user_id]),
			    KEEPFILTERS(openair_toil[toil_required] = "Yes")
			)
		lineageTag: 318f765b-f28e-4879-a365-6a3148fee0d8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '%People with TOIL requirements' =
			
			DIVIDE(
			    CALCULATE(
			        COUNT('openair_toil'[user_id]),
			        KEEPFILTERS('openair_toil'[toil_required] = "Yes")
			    ),
			    COUNT('openair_toil'[user_id])
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 0fbdc0ba-4a5a-4468-976b-b17b5dcf579c

