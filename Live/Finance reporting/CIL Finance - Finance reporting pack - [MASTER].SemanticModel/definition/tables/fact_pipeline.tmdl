	column age_bucket =
			
			SWITCH(
			    TRUE(),
			    'fact_pipeline'[days_in_pipeline] < 30, "< 30 days",
			    'fact_pipeline'[days_in_pipeline] >= 30 && 'fact_pipeline'[days_in_pipeline] <= 60, "30 - 60 days",
			    'fact_pipeline'[days_in_pipeline] >= 60 && 'fact_pipeline'[days_in_pipeline] <= 90, "60 - 90 days",
			    'fact_pipeline'[days_in_pipeline] > 90, "> 90 days",
			    "Unknown"
			)
		lineageTag: aee735f7-0a52-43ce-b716-d6d42c4baa17
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column IsMostRecentMonday =
			
			VAR MostRecentMonday =
			    TODAY()
			        - WEEKDAY(TODAY(), 2)
			        + 1
			RETURN
			IF([week_start_date] = MostRecentMonday, 1, 0)
		formatString: 0
		lineageTag: bbea7dff-6998-4a4d-bf30-295d21ba448f
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

