		summarizeBy: sum
		isNameInferred
		sourceColumn: [WeekNo]

		annotation SummarizationSetBy = Automatic

	column FY =
			IF(
			    dim_date[MonthNo] >= 7, "FY"&RIGHT(CONVERT(dim_date[Year] + 1, STRING), 2),
			    "FY"&RIGHT(CONVERT(dim_date[Year], STRING), 2)
			)
		lineageTag: b8d30c89-e27c-40ab-a6e7-ef8fc40a9f89
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Week = ```
			dim_date[Date] - WEEKDAY(dim_date[Date], 2) + 1
			
			```
		formatString: General Date
		lineageTag: 5410779e-48dc-4281-a6a2-b369cb4d6d3f
		summarizeBy: none

		variation Variation
			isDefault
			relationship: c83c87b3-7e0d-445c-b633-d957f39a7281
			defaultHierarchy: LocalDateTable_429efdf4-fa24-4460-8aa1-e45c0808db5d.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	partition dim_date = calculated
		mode: import
		source =
				ADDCOLUMNS(CALENDAR(FIRSTDATE(fact_revenue[date_stamp]), LASTDATE(fact_revenue[date_stamp])),
				
				
				"Year", FORMAT([Date], "yyyy"),
				
				
				
				
				"MonthNo", MONTH([Date]),
				
				
				
				
				"Month", FORMAT([Date],"MMM"),
				
				
				
				
				"Quarter", FORMAT([Date],"\QQ"),
				
				
				
				
				"YearMonth", FORMAT([Date],"YYYY-MM"),
				
				
				
				
				"WeekdayNo", WEEKDAY([Date],2), //1-Sun..Sat, 2-Mon..Sat
				
				
				
				
				"Weekday", FORMAT([Date],"ddd"),
				
				
				
				
				"Week-(day-end)3", IF(FORMAT(WEEKDAY([Date],2),"ddd") IN {"sat", "sun"}, 1,0 ),
				
				
				"Week End Date", [Date] + 7 - WEEKDAY([DATE],2),
				
				
				"WeekNo", WEEKNUM([Date], 2))

	annotation PBI_Id = 17842d42f5e8410983a9f1a4ca952640

