table 'Measures folder'
	lineageTag: 341866cc-7a40-47b8-8f12-6c207ba5c7d3

	measure 'Budgeted fee' = CALCULATE(SUM(dim_projects[fee_budgeted_gbp]), USERELATIONSHIP(dim_date[Date], dim_projects[live_date]))
		formatString: "£"#,0;-"£"#,0;"£"#,0
		displayFolder: Fees
		lineageTag: 730e436e-98f2-4724-a6df-0d013fb7b9a7

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Final fee' = SUM(dim_projects[fee_final_gbp])
		formatString: "£"#,0;-"£"#,0;"£"#,0
		displayFolder: Fees
		lineageTag: 1867c5de-d9ab-4996-9365-2f2db43847cc

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure Revenue =
			
			CALCULATE(
			    SUM ( fact_revenue[allocation_gbp] ),
			    fact_revenue[record_type] = "Committed",
			    USERELATIONSHIP ( dim_date[Date], fact_revenue[date_stamp] ),
			    USERELATIONSHIP ( dim_projects[project_id], fact_revenue[project_id] )
			)
		formatString: "£"#,0;-"£"#,0;"£"#,0
		displayFolder: Revenue
		lineageTag: 9bde657b-6323-410b-b7ee-e921fbbfac96

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Spend to date' = CALCULATE(SUM(fact_timesheets[outcome_gbp]), fact_timesheets[booking_type] = "Timesheet")
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		displayFolder: Timesheet
		lineageTag: e0f87fcc-312b-4c91-a51e-eed82a8eb215

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Hours to date' = CALCULATE(SUM(fact_timesheets[total_hours]), fact_timesheets[booking_type] = "Timesheet")
		displayFolder: Timesheet
		lineageTag: e5587cef-eb53-461f-ab59-3afebee3bdc5

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Hours to go' = CALCULATE(SUM(fact_timesheets[total_hours]), fact_timesheets[booking_type] <> "Timesheet")
		displayFolder: Timesheet
		lineageTag: 75100ba3-e26e-4276-96f5-41dd8118e65f

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Spend to go' = CALCULATE(DIVIDE(SUM(fact_timesheets[outcome_gbp]), 7.5, BLANK()), fact_timesheets[booking_type] <> "Timesheet") * 10
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		displayFolder: Timesheet
		lineageTag: 0a45f904-8d4d-42b4-95ec-eeada68de12e

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Projected outcome' = [Spend to date] + [Spend to go]
		formatString: "£"#,0;-"£"#,0;"£"#,0
		displayFolder: KPIs
		lineageTag: 4e32e31c-b640-4440-8ff2-95ec45823448

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure Recovery = CALCULATE(DIVIDE([Revenue], [Projected outcome], BLANK()))
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: KPIs
		lineageTag: ba1e0dd5-ba8e-4e27-b1a5-d08ed71c0518

		changedProperty = IsHidden

	measure 'Market study' = CALCULATE(SUM(fact_invoice_line_items[total_gbp]), fact_invoice_line_items[category_name] = "Market study", fact_invoice_line_items[approval_status] = "Approved", USERELATIONSHIP(dim_date[Date], fact_invoice[date_stamp]))
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		displayFolder: Invoices
		lineageTag: 3ecc8a5f-ad7d-4562-8b97-12f36e633419

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Bidder meetings' = CALCULATE(SUM(fact_invoice_line_items[total_gbp]), fact_invoice_line_items[category_name] = "Bidder meetings", fact_invoice_line_items[approval_status] = "Approved", USERELATIONSHIP(dim_date[Date], fact_invoice[date_stamp]))
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		displayFolder: Invoices
		lineageTag: f9eb7278-134e-4bd7-89b9-cf2485cb7602

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure Uplift = CALCULATE(SUM(fact_invoice_line_items[total_gbp]), fact_invoice_line_items[category_name] = "Uplift", fact_invoice_line_items[approval_status] = "Approved", USERELATIONSHIP(dim_date[Date], fact_invoice[date_stamp]))
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		displayFolder: Invoices
		lineageTag: 3025240c-af78-48c9-b775-48071e6a0a7f

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure Other = CALCULATE(SUM(fact_invoice_line_items[total_gbp]), fact_invoice_line_items[category_name] = "Other", fact_invoice_line_items[approval_status] = "Approved", USERELATIONSHIP(dim_date[Date], fact_invoice[date_stamp]))
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		displayFolder: Invoices
		lineageTag: 8026ace9-599d-489b-9f65-8e29d86644c3

