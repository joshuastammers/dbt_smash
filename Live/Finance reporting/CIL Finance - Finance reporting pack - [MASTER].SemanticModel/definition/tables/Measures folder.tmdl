	measure 'Interest charge' = CALCULATE(SUM(fact_invoice_line_items[total_gbp]), fact_invoice_line_items[category_name] = "Interest charge*", fact_invoice[approval_status] = "Approved")
		formatString: "£"#,0;-"£"#,0;"£"#,0
