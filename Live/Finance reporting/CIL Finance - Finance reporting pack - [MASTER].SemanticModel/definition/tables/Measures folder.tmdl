	measure 'Min fee - not specified client size' = CALCULATE([Min fee], dim_projects[client_target_size_category] = "Not specified")
		displayFolder: Fees
		lineageTag: 98ef6978-d833-4317-9444-004fca0db8fd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Min fee % - client target size' = DIVIDE([Min fee], [Min fee - small client] + [Min fee - large client] + [Min fee - not specified client size], BLANK())
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Fees
		lineageTag: c279d16b-f163-4d2e-8db9-bfcac4104b2d

	measure 'Allocation %' = CALCULATE(AVERAGEX(fact_revenue, AVERAGE(fact_revenue[allocation_pct])),fact_revenue[record_type] = "Committed")
		formatString: 0%;-0%;0%
		displayFolder: Revenue
		lineageTag: d9c1a289-e173-4ead-b07d-ee399288d6ec

	measure Allocation = ```
			[Final fee] * [Allocation %]
			
			```
		formatString: "£"#,0;-"£"#,0;"£"#,0
		displayFolder: Revenue
		lineageTag: 4af78656-2c97-469d-8c88-48f6d85ed8c9

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Final fee - live date' = CALCULATE([Final fee], USERELATIONSHIP(dim_date[Date], dim_projects[live_date]))
		formatString: "£"#,0;-"£"#,0;"£"#,0
		displayFolder: Fees
		lineageTag: faac1f47-bb13-4e2d-891d-ad019d4fe197

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure Discount = CALCULATE(SUM(dim_projects[fee_discount_gbp]), USERELATIONSHIP(dim_date[Date], dim_projects[live_date]))
		formatString: "£"#,0;-"£"#,0;"£"#,0
		displayFolder: Fees
		lineageTag: cfac37ac-b36a-46cd-bd08-1a746dea34bd

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Discount %' = CALCULATE(1 + AVERAGE(dim_projects[discount_percent]), USERELATIONSHIP(dim_date[Date], dim_projects[live_date]))
		formatString: 0%;-0%;0%
		displayFolder: Fees
		lineageTag: 8841eea3-936e-44f1-af2e-f525eba5862d

	measure 'Delivery variance' = IF([Budgeted fee] > 0, [Projected outcome] - [Budgeted fee], BLANK())
		formatString: "£"#,0;-"£"#,0;"£"#,0
		displayFolder: KPIs
		lineageTag: 3b6565f9-9664-40b9-a16d-db9c0c68da16

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Delivery recovery %' = ```
			
			IF(
			    OR([Budgeted fee] = 0, [Projected outcome] = 0),
			    BLANK(),
			    DIVIDE([Budgeted fee], [Projected outcome], BLANK())
			)
			
			```
		formatString: 0%;-0%;0%
		displayFolder: KPIs
		lineageTag: 7d8f417c-32be-4e4e-93db-a9d68d707d35

	measure Tax = CALCULATE(SUM(fact_invoice_line_items[tax_gbp]), USERELATIONSHIP(dim_date[Date], fact_invoice[date_stamp]))
