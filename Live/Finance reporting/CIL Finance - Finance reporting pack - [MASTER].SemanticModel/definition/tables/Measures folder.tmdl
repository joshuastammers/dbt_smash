		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure Expenses = CALCULATE(SUM(fact_invoice_line_items[total_gbp]), fact_invoice_line_items[category_name] IN {"Expenses", "Interest charge*"}, USERELATIONSHIP(dim_date[Date], fact_invoice[date_stamp]))
		formatString: "£"#,0;-"£"#,0;"£"#,0
		displayFolder: Invoices
		lineageTag: 9d82e816-cb19-437d-8163-7ccfaf622b8b

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure Outlays = CALCULATE(SUM(fact_invoice_line_items[total_gbp]), fact_invoice_line_items[category_name] = "Outlays", USERELATIONSHIP(dim_date[Date], fact_invoice[date_stamp]))
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		displayFolder: Invoices
		lineageTag: f83558f8-a4b5-4f1c-b4f3-6557bcc28b2a

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure Invoiced = [Market study] + [Bidder meetings] + [Uplift] + [Other] + [Interest charge]
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		displayFolder: Invoices
		lineageTag: ca943f64-6965-4784-a377-4ae858a6b745

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'WIP - final fee(?)' = CALCULATE([Revenue Up to Current Month], USERELATIONSHIP(dim_date[date], dim_projects[start_date])) - CALCULATE([Invoiced], USERELATIONSHIP(dim_date[date], dim_projects[start_date]))
		formatString: "£"#,0.0;-"£"#,0.0;"£"#,0.0
		displayFolder: WIP
		lineageTag: 17906e9e-e008-49e1-916e-2ffb4cec61c2

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Recovery YTD (previous month)' =
			
			CALCULATE(
			    [Recovery],
			    DATESYTD(dim_date[Date], "6/30"),
			    dim_date[Date] <= EOMONTH(TODAY(), -1)
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: KPIs
		lineageTag: c08b103f-b629-4bd5-9fc0-0e4969917450

		changedProperty = IsHidden

	measure 'Revenue YTD (previous month)' =
			
			CALCULATE(
			    [Revenue],
			    DATESYTD(dim_date[Date], "6/30"),
			    dim_date[Date] <= EOMONTH(TODAY(), -1)
			)
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		displayFolder: KPIs
		lineageTag: 6288c975-4134-41e1-8567-786493a846e6

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Revenue PY' = CALCULATE([Revenue], SAMEPERIODLASTYEAR(dim_date[Date]))
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		displayFolder: Revenue
		lineageTag: cf173549-80f4-4e3a-9503-e6c189d37382

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Min fee' = CALCULATE(SUM(dim_projects[fee_minimum_gbp]), USERELATIONSHIP(dim_date[Date], dim_projects[live_date]))
