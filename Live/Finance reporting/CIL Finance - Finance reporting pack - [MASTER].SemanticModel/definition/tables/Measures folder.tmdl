	measure 'Revenue L12M' =
			
			
			VAR AnchorDate = MAX(dim_date[Date])   -- month on the x-axis
			
			-- Get the selected FY date range: remove ONLY the axis filter, keep slicers (e.g., FY)
			VAR SelDates =
			    CALCULATETABLE(
			        VALUES(dim_date[Date]),
			        REMOVEFILTERS(dim_date[Date])
			    )
			VAR SelStart = MINX(SelDates, dim_date[Date])
			VAR SelEnd = MAXX(SelDates, dim_date[Date])
			
			RETURN
			IF (
			    ISBLANK(SelStart) || AnchorDate < SelStart || AnchorDate > SelEnd,
			    BLANK(),  -- hide months outside selected FY
			    CALCULATE(
			        SUM(fact_revenue[allocation_gbp]),
			        fact_revenue[record_type] = "Committed",
			        USERELATIONSHIP(dim_date[Date], fact_revenue[date_stamp]),
			        -- ignore slicers for the LTM calculation window
			        REMOVEFILTERS(dim_date),
			        DATESINPERIOD(dim_date[Date], AnchorDate, -12, MONTH)
			    )
			)
		formatString: "£"#,0;-"£"#,0;"£"#,0
		displayFolder: Revenue
		lineageTag: 2aacc97c-a919-4614-b82f-8b5de4a16487

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Revenue L6M' =
			
			
			VAR AnchorDate = MAX(dim_date[Date])   -- month on the x-axis
			
			-- Get the selected FY date range: remove ONLY the axis filter, keep slicers (e.g., FY)
			VAR SelDates =
			    CALCULATETABLE(
			        VALUES(dim_date[Date]),
			        REMOVEFILTERS(dim_date[Date])
			    )
			VAR SelStart = MINX(SelDates, dim_date[Date])
			VAR SelEnd = MAXX(SelDates, dim_date[Date])
			
			RETURN
			IF (
			    ISBLANK(SelStart) || AnchorDate < SelStart || AnchorDate > SelEnd,
			    BLANK(),  -- hide months outside selected FY
			    CALCULATE(
			        SUM(fact_revenue[allocation_gbp]),
			        fact_revenue[record_type] = "Committed",
			        USERELATIONSHIP(dim_date[Date], fact_revenue[date_stamp]),
			        -- ignore slicers for the LTM calculation window
			        REMOVEFILTERS(dim_date),
			        DATESINPERIOD(dim_date[Date], AnchorDate, -6, MONTH)
