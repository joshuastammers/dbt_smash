			)
		formatString: "£"#,0;-"£"#,0;"£"#,0
		displayFolder: Revenue
		lineageTag: e7363994-964f-4696-adc2-68a61e7cbac2

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'New & upgraded opportunities' =
			
			VAR _result =
			    CALCULATE (
			        DISTINCTCOUNT ( fact_pipeline[opportunity_id] ),
			        // apply the same three branches, but for the week in context
			        KEEPFILTERS (
			            FILTER (
			                fact_pipeline,
			                (
			                    ( fact_pipeline[stage] IN { "-1 Hot", "0 Imminent" }
			                        && ISBLANK ( fact_pipeline[last_week_stage] ) )
			                    || ( fact_pipeline[stage] = "1 Won"
			                        && ISBLANK ( fact_pipeline[last_week_stage] ) )
			                    || ( fact_pipeline[stage] = "1 Won"
			                        && fact_pipeline[last_week_stage] IN { "-2 Warm", "-3 Lead", "-4 Prospect" } )
			                    || ( fact_pipeline[last_week_stage] IN { "-2 Warm", "-3 Lead", "-4 Prospect" }
			                        && fact_pipeline[stage] IN { "-1 Hot", "0 Imminent" } )
			                )
			            )
			        )
			    )
			RETURN
			    _result
		formatString: 0
		displayFolder: Opportunities
		lineageTag: a0ff012a-8ea2-431c-aba5-c5b76c0ae07d

	measure 'Weighted fee (imminenmt)' = CALCULATE(SUM(fact_pipeline[weighted_fee_gbp]), fact_pipeline[stage] in {"0 Imminent"})
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		displayFolder: Opportunities
		lineageTag: 9b8a0f9b-4096-402d-9af3-108282fd37ee

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Weighted fee (hot)' = CALCULATE(SUM(fact_pipeline[weighted_fee_gbp]), fact_pipeline[stage] in {"-1 Hot"})
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		displayFolder: Opportunities
		lineageTag: d314e3d8-e859-435e-b678-48b12ff44145

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Upgraded opps' =
			
			COALESCE(
			    CALCULATE(
			        DISTINCTCOUNT(fact_pipeline[opportunity_id]),
			        fact_pipeline[last_week_stage] IN { "-2 Warm", "-3 Lead", "-4 Prospect" },
			        fact_pipeline[stage] IN { "-1 Hot", "0 Imminent" }
			    ),
			    0
			)
		formatString: 0
		displayFolder: Opportunities
		lineageTag: eddaaeec-a310-47c9-a1f0-6e015e325b68

	measure 'New opportunities' =
			
			VAR _result =
			    CALCULATE (
			        DISTINCTCOUNT ( fact_pipeline[opportunity_id] ),
			        -- apply the same three branches, but for the week in context
			        KEEPFILTERS (
			            FILTER (
			                fact_pipeline,
			                (
			                    ( fact_pipeline[stage] IN { "-1 Hot", "0 Imminent" }
			                      && ISBLANK ( fact_pipeline[last_week_stage] )
			                    )
			                    || ( fact_pipeline[stage] = "1 Won"
			                        && ISBLANK ( fact_pipeline[last_week_stage] )
			                    )
			                    || ( fact_pipeline[stage] = "1 Won"
			                        && fact_pipeline[last_week_stage] IN { "-2 Warm", "-3 Lead", "-4 Prospect" }
			                    )
			                )
			            )
			        )
			    )
			RETURN _result
		formatString: 0
		displayFolder: Opportunities
		lineageTag: f9d71480-197c-4c69-b6d5-d42e67cb9e63

	measure 'Number of opportunities' = DISTINCTCOUNT( fact_pipeline[opportunity_id] )
		formatString: 0
		displayFolder: Opportunities
		lineageTag: 0fa15f72-c675-4f13-bdff-362b845907a3

	measure 'Pipeline weighted fee' = CALCULATE(SUM(fact_pipeline[weighted_fee_gbp]), fact_pipeline[stage] in {"-1 Hot", "0 Imminent"})
		formatString: "£"#,0.0;-"£"#,0.0;"£"#,0.0
		displayFolder: Opportunities
		lineageTag: 33c45f87-78c5-4f4b-a11f-a832378c98ce

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Latest Weighted Fee' =
			
			SUMX(
			    VALUES ( fact_opportunities[opportunity_id] ),
			    VAR OppId =
			        SELECTEDVALUE ( fact_opportunities[opportunity_id] )
			    VAR LatestDate =
			        CALCULATE (
			            MAX ( fact_pipeline[week_start_date] ),
			            fact_pipeline[opportunity_id] = OppId
			        )
			    RETURN
			        CALCULATE (
			            MAX ( fact_pipeline[weighted_fee_gbp] ),
			            fact_pipeline[opportunity_id] = OppId,
			            fact_pipeline[week_start_date] = LatestDate
			        )
			) / 1000
		displayFolder: Opportunities
		lineageTag: 35bf4d8f-dde0-4ea7-aa72-84bf34ed533b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Days in pipeline' =
			
			SUMX(
			    VALUES ( fact_opportunities[opportunity_id] ),
			    VAR OppId =
			        SELECTEDVALUE ( fact_opportunities[opportunity_id] )
			    VAR LatestDate =
			        CALCULATE (
			            MAX ( fact_pipeline[week_start_date] ),
			            fact_pipeline[opportunity_id] = OppId
			        )
			    RETURN
			        CALCULATE (
			            MAX ( fact_pipeline[days_in_pipeline] ),
			            fact_pipeline[opportunity_id] = OppId,
			            fact_pipeline[week_start_date] = LatestDate
			        )
			)
		formatString: 0
		displayFolder: Opportunities
		lineageTag: cb12ca34-72ce-4ad0-811e-bd0d4b8d87b8

	measure 'WIP - actual' =
			
			
			[Revenue Up to Current Month] - [Invoiced]
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
