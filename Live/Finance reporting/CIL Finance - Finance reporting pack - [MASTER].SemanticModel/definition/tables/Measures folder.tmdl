	measure 'Revenue Up to Current Month' =
			
			CALCULATE(
			    [Revenue],
			    FILTER(
			        ALL('dim_date'),
			        'dim_date'[Date] <= EOMONTH(TODAY(), 0)
			    )
			)
		formatString: "£"#,0.0;-"£"#,0.0;"£"#,0.0
		displayFolder: KPIs
		lineageTag: 441d2b91-532a-4df6-8e35-07bea042e2d3

