		formatString: 0
		displayFolder: Orders
		lineageTag: 3d3e1aa5-3afa-4de3-bb9d-733ce04ad411

	measure 'Min fee - small client' = CALCULATE([Min fee], dim_projects[client_target_size_category] = "Small")
		displayFolder: Fees
		lineageTag: 8bb5517f-2bae-447d-9eab-390fbedf983d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Min fee - large client' = CALCULATE([Min fee], dim_projects[client_target_size_category] = "Large")
