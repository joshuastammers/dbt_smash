		lineageTag: 7d8f417c-32be-4e4e-93db-a9d68d707d35

	measure Tax = CALCULATE(SUM(fact_invoice_line_items[tax_gbp]), USERELATIONSHIP(dim_date[Date], fact_invoice[date_stamp]))*SELECTEDVALUE(Currencies[conversion_rate])
