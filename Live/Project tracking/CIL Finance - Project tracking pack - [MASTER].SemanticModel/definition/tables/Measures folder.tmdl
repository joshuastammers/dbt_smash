	measure 'Engagement support costs' =
			
			
			([Min fee] + [Phases]) * 0.03
		lineageTag: 671a1d69-64df-4787-b9cb-cc4564121937

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total spend - Purchases box' =
			
			COALESCE((SUM(fact_purchase_item_line_items[total_actual])*SELECTEDVALUE(Currencies[conversion_rate])),0)
		lineageTag: 505b49b9-6bed-4727-89b1-7caae25405cc

