		lineageTag: 1ebdc37c-0679-4632-b653-bf55c009b494

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% of budget used' = ```
			
			DIVIDE([Total costs], [Total spend - Expense cap])
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: e85b714c-ead7-46df-8bb8-66d6ae696c71

	measure 'Total spend (in. Tax) - Expenses table' =
			
			
			SUM(fact_expenses[total_gbp])*SELECTEDVALUE(Currencies[conversion_rate])
		lineageTag: 51c3d789-7a83-4faa-82b1-e8ad6f2b1e9e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total spend - Expense cap' = ```
			
			VAR CapOg =
			    SUM(dim_projects[expense_cap_gbp]) * SELECTEDVALUE(Currencies[conversion_rate])
			RETURN
			    IF(
			        ISBLANK(CapOg) || CapOg = 0,
			        [Min fee] * 0,      //kept this clause in as might want to change to 0.15 in future.
			        CapOg
			    )
			
			```
		lineageTag: 0e9d7739-1b60-4903-a9c4-2ae926a2ba9d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

