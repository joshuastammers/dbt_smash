	measure Other = CALCULATE(SUM(fact_invoice_line_items[total_gbp]), fact_invoice_line_items[category_name] = "Other", fact_invoice_line_items[approval_status] = "Approved", USERELATIONSHIP(dim_date[Date], fact_invoice[date_stamp]))*SELECTEDVALUE(Currencies[conversion_rate])
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		displayFolder: Invoices
		lineageTag: 8026ace9-599d-489b-9f65-8e29d86644c3

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure Expenses = CALCULATE(SUM(fact_invoice_line_items[total_gbp]), fact_invoice_line_items[category_name] = "Expenses", USERELATIONSHIP(dim_date[Date], fact_invoice[date_stamp]))*SELECTEDVALUE(Currencies[conversion_rate])
		formatString: 0.00
		displayFolder: Invoices
		lineageTag: 9d82e816-cb19-437d-8163-7ccfaf622b8b

		changedProperty = IsHidden

	measure Outlays = CALCULATE(SUM(fact_invoice_line_items[total_gbp]), fact_invoice_line_items[category_name] = "Outlays", USERELATIONSHIP(dim_date[Date], fact_invoice[date_stamp]))*SELECTEDVALUE(Currencies[conversion_rate])
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		displayFolder: Invoices
		lineageTag: f83558f8-a4b5-4f1c-b4f3-6557bcc28b2a

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure Invoiced = [Market study] + [Bidder meetings] + [Uplift] + [Other]
		formatString: #,0
		displayFolder: Invoices
		lineageTag: ca943f64-6965-4784-a377-4ae858a6b745

		changedProperty = IsHidden

	measure 'WIP *' = [Revenue Booked *] - [Invoiced]
		formatString: #,0
		displayFolder: WIP
		lineageTag: 17906e9e-e008-49e1-916e-2ffb4cec61c2

		changedProperty = IsHidden

	measure 'Recovery YTD (previous month)' =
			
			CALCULATE(
			    [Recovery],
			    DATESYTD(dim_date[Date], "6/30"),
			    dim_date[Date] <= EOMONTH(TODAY(), -1)
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: KPIs
		lineageTag: c08b103f-b629-4bd5-9fc0-0e4969917450

		changedProperty = IsHidden

	measure 'Revenue Booked (previous month)' =
			
			CALCULATE(
			    [Revenue],
			    DATESYTD(dim_date[Date], "6/30"),
			    dim_date[Date] <= EOMONTH(TODAY(), -1)
			)
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		displayFolder: KPIs
		lineageTag: 6288c975-4134-41e1-8567-786493a846e6

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Revenue PY' = CALCULATE([Revenue], SAMEPERIODLASTYEAR(dim_date[Date]))
		formatString: "£"#,0.00;-"£"#,0.00;"£"#,0.00
		displayFolder: Revenue
		lineageTag: cf173549-80f4-4e3a-9503-e6c189d37382

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Min fee' = CALCULATE(SUM(dim_projects[fee_minimum_gbp]), USERELATIONSHIP(dim_date[Date], dim_projects[live_date]))*SELECTEDVALUE(Currencies[conversion_rate])
		formatString: #,0
		displayFolder: Fees
		lineageTag: bcd40a77-2ceb-4a4d-8df4-aebab0b61b59

	measure 'Number of orders' = CALCULATE(DISTINCTCOUNT(dim_projects[project_id]), USERELATIONSHIP(dim_date[Date], dim_projects[live_date]))
		formatString: 0
		displayFolder: Orders
		lineageTag: 3d3e1aa5-3afa-4de3-bb9d-733ce04ad411

	measure 'Min fee - small client' = CALCULATE([Min fee], dim_projects[client_target_size_category] = "Small")
		displayFolder: Fees
		lineageTag: 8bb5517f-2bae-447d-9eab-390fbedf983d

