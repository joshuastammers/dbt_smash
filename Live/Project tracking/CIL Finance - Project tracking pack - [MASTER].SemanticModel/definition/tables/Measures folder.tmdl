		lineageTag: 6c1109c6-81fb-4d10-b8fc-b7c92f50bacd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Debtors (PT)' = COALESCE(CALCULATE([Invoiced], FILTER(fact_invoice, fact_invoice[paid_status] = "Unpaid")), 0)
		displayFolder: Debtors
		lineageTag: 984e1304-e62a-465d-b6fd-c9e8a6f733d0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Project budget' = SUM(fact_project_budgets[budget_gbp])*SELECTEDVALUE(Currencies[conversion_rate])
		formatString: #,0
		displayFolder: KPIs
		lineageTag: b7abdaad-daf4-45af-abe6-fe39809e875c

	measure 'Revenue Booked *' =
			
			CALCULATE(
			    [Revenue],
			    fact_revenue[date_stamp] <= EOMONTH(TODAY(), 0)
			)
		displayFolder: KPIs
		lineageTag: 71d9e0a6-f147-4ac6-89f8-c18be9120d32

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Phases = CALCULATE(SUM(dim_projects[fee_phases_gbp]), USERELATIONSHIP(dim_date[Date], dim_projects[live_date]))*SELECTEDVALUE(Currencies[conversion_rate])
		formatString: #,0
		displayFolder: Fees
		lineageTag: c16dfc15-c914-4327-8b80-24abd0dbc47e

	measure Success = CALCULATE(SUM(dim_projects[fee_success_gbp]), USERELATIONSHIP(dim_date[Date], dim_projects[live_date]))*SELECTEDVALUE(Currencies[conversion_rate])
		formatString: #,0
		displayFolder: Fees
		lineageTag: d3439042-c5a0-4ee6-8fc4-1423850f8f96

	measure 'Bidder meetings fee' = CALCULATE(SUM(dim_projects[fee_bidder_meeetings_gbp]), USERELATIONSHIP(dim_date[Date], dim_projects[live_date]))*SELECTEDVALUE(Currencies[conversion_rate])
		formatString: #,0
		displayFolder: Fees
		lineageTag: cc9906cd-d9dc-411c-8157-d323394ca3d0

	measure 'Uplift fee' = CALCULATE(SUM(dim_projects[fee_uplift_gbp]), USERELATIONSHIP(dim_date[Date], dim_projects[live_date]))*SELECTEDVALUE(Currencies[conversion_rate])
		formatString: #,0
		displayFolder: Fees
		lineageTag: debbb429-5022-4506-b2e2-397889087131

	measure Reduction = CALCULATE(SUM(dim_projects[fee_reduction_gbp]), USERELATIONSHIP(dim_date[Date], dim_projects[live_date]))*SELECTEDVALUE(Currencies[conversion_rate])
		formatString: #,0
		displayFolder: Fees
		lineageTag: 670f0637-9e7f-40f4-8ae7-b2b869566e6a

	measure 'Total invoiced' = [Invoiced] + [Expenses & outlays] + [Tax]
		formatString: #,0
		displayFolder: Invoices
		lineageTag: 34179684-a68b-43cb-ae6e-f0dda8cfdca1

	measure 'Freelancers Spend' = CALCULATE(SUM(fact_timesheets[outcome_gbp]), fact_timesheets[booking_type] = "Timesheet", fact_timesheets[job_code_contemporaneous] = "9. Interviewer")
		formatString: "£"#,0;-"£"#,0;"£"#,0
		displayFolder: Timesheet
		lineageTag: cfdb99c9-2cd4-4080-a9a2-01b70858318e

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure Cash = COALESCE(CALCULATE([Invoiced], FILTER(fact_invoice, fact_invoice[paid_status] = "Paid")), 0)
		displayFolder: Debtors
		lineageTag: 24a46640-5008-4410-802b-f7c44309f157

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Spend to date %' = DIVIDE([Spend to date], [Projected outcome], 0)
		formatString: 0%;-0%;0%
		displayFolder: Timesheet
		lineageTag: a3cb38cc-91c3-445d-a917-31718120830e

	measure 'Spend to go %' = DIVIDE([Spend to go], [Projected outcome], 0)
