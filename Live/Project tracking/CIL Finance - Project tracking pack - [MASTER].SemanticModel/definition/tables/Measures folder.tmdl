	measure 'Discount %' = CALCULATE(AVERAGE(dim_projects[discount_percent]), USERELATIONSHIP(dim_date[Date], dim_projects[live_date]))
		formatString: 0%;-0%;0%
		displayFolder: Fees
		lineageTag: 8841eea3-936e-44f1-af2e-f525eba5862d

	measure 'Delivery variance' = IF([Budget] > 0, [Budget] - [Projected outcome], BLANK())
		formatString: "£"#,0;-"£"#,0;"£"#,0
		displayFolder: KPIs
		lineageTag: 3b6565f9-9664-40b9-a16d-db9c0c68da16

