	column paid_status =
			
			IF(
			    COUNTROWS(
			        CALCULATETABLE(
			            fact_payments,
			            USERELATIONSHIP(fact_payments[invoice_id], fact_invoice[invoice_id])
			        )
			    ) > 0,
			    "Paid",
			    "Unpaid"
			)
		lineageTag: 6c0ed98e-09b6-484e-9351-848359706b85
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

