	measure 'Closest CIL''er' = ```
			
			VAR MaxDistinct = 
			    MAXX(
			        SUMMARIZE(
			            dim_narrative_internal,
			            dim_narrative_internal[cil_employee],
			            "DistinctCount", 
			            CALCULATE(DISTINCTCOUNT(dim_narrative_internal[narrative_id]))
			        ),
			        [DistinctCount]
			    )
			RETURN
			    MAXX(
			        FILTER(
			            SUMMARIZE(
			                dim_narrative_internal,
			                dim_narrative_internal[cil_employee],
			                "DistinctCount", 
			                CALCULATE(DISTINCTCOUNT(dim_narrative_internal[narrative_id]))
			            ),
			            [DistinctCount] = MaxDistinct
			        ),
			        dim_narrative_internal[cil_employee]
			    )
			```
		lineageTag: cc6cc837-4db0-4cbe-a538-32d3138af0ee

