table 'Measures Table'
	lineageTag: 3be6a0fa-2472-4aa5-a5ff-4409f9a56ca9

	measure 'Fees (£k) per Interaction (Over Threshold)' = [Fees (£k)]/[Interactions (Over Threshold)]
		formatString: #,0.0
		displayFolder: Fees
		lineageTag: e3f7da20-cf17-4d0b-96ce-e23e099c44e0

	measure 'Fees (£k)' = (SUM(fact_openair_project[fee_final_gbp])/1000)
		formatString: #,0.0
		displayFolder: Fees
		lineageTag: 63c0aca2-487b-4fd2-ba60-e325bed14e7b

	measure 'Hot+ Opportunities per Interaction (Over Threshold)' = [Hot+ Opportunities]/([Interactions (Over Threshold)]+0)
		displayFolder: Opportunities\Hot+
		lineageTag: 1fadca69-5a0c-4649-bb84-ffe91a70857b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Fees vs. prior LTM' = SUM(fact_openair_project[fee_final_gbp])-CALCULATE(SUM(fact_openair_project[fee_final_gbp]),SAMEPERIODLASTYEAR(Date__c[Date]))
		formatString: " +£#,##0.00;-#£,##0.00"
		displayFolder: Fees
		lineageTag: 34dd665c-6e48-4801-bf07-08276a887c82

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Median Project Recovery to Budget' =
			
			MEDIANX(
				KEEPFILTERS(VALUES('fact_openair_project'[project_code])),
				CALCULATE([Recovery to Final Fee])
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Recovery
		lineageTag: c27b04f3-f23b-4753-a443-d2006ee13f46

	measure 'Won Opportunities' = CALCULATE(DISTINCTCOUNT(fact_opportunities[opportunity_id]),fact_opportunities[stage]="1 Won")+0
