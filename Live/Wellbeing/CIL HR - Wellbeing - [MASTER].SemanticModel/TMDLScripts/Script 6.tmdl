createOrReplace

	ref table dim_date

		column 'flag w-1' = ```
				
				
				VAR TodayDate = TODAY() 
				VAR StartThisWeek = TodayDate - WEEKDAY(TodayDate, 2) + 1 
				VAR StartLastWeek = StartThisWeek - 7
				RETURN 
				IF(dim_date[date_week_commencing] = StartLastWeek, 1, 0)
				```
			formatString: 0
			lineageTag: fd41cf72-1892-4636-bb13-56c00381105e
			summarizeBy: sum

			annotation SummarizationSetBy = Automatic

