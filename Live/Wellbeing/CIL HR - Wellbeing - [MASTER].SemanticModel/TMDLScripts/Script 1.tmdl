createOrReplace
    table 'CY vs PY'      
        calculationGroup
            precedence: 2
			            
			calculationItem CY = SELECTEDMEASURE()
				
			calculationItem PY = 
				CALCULATE(
					SELECTEDMEASURE(),
					SAMEPERIODLASTYEAR(dim_date[Date])
					)
			
        column 'CY vs PY'
            dataType: string                        
            sourceColumn: Name
            sortByColumn: Ordinal          
        column Ordinal
            dataType: int64
            formatString: 0        
            summarizeBy: none
            sourceColumn: Ordinal